# =============================================================================
# Zolution — Root .gitignore
# Covers: Python, Node/Angular, Docker, IDE, OS, secrets
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & secrets — NEVER commit real credentials
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
secrets/
*.pem
*.key
*.p12
*.pfx

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
ENV/
.Python
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
*.pyo
*.pyd
.python-version
Pipfile.lock
poetry.lock

# Alembic
alembic/versions/__pycache__/

# -----------------------------------------------------------------------------
# Node / Angular / JavaScript
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn/
.pnp.*
dist/
.angular/
.sass-cache/
*.tsbuildinfo
.eslintcache
*.js.map

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
*.log
docker-compose.override.yml

# -----------------------------------------------------------------------------
# IDE — VSCode
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.code-workspace

# IDE — JetBrains (IntelliJ, PyCharm, WebStorm)
.idea/
*.iml
*.ipr
*.iws
out/
.idea_modules/

# IDE — Eclipse
.classpath
.project
.settings/

# -----------------------------------------------------------------------------
# Operating System
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.swp
*.orig
.cache/
coverage/
.nyc_output/
