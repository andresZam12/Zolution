# =============================================================================
# Zolution Frontend — Environment Variables
# Copy to frontend/.env and fill in real values.
# NEVER commit frontend/.env to version control.
#
# In Angular, variables must be mapped in environment.ts files.
# Prefix with NG_APP_ for use with @ngx-env/builder, or manage via
# environment.ts / environment.prod.ts directly.
# =============================================================================

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
NG_APP_API_BASE_URL=http://localhost:8000/api/v1

# -----------------------------------------------------------------------------
# Auth0 (Angular SDK — @auth0/auth0-angular)
# See: https://manage.auth0.com/ → Applications → your SPA application
# -----------------------------------------------------------------------------
NG_APP_AUTH0_DOMAIN=your-tenant.auth0.com
NG_APP_AUTH0_CLIENT_ID=your_angular_client_id
NG_APP_AUTH0_AUDIENCE=https://api.zolution.app
NG_APP_AUTH0_REDIRECT_URI=http://localhost:4200/callback

# -----------------------------------------------------------------------------
# Feature flags (for gradual rollout during development)
# -----------------------------------------------------------------------------
NG_APP_FEATURE_CHAT_PREVIEW=true
NG_APP_FEATURE_SUPERADMIN=false
